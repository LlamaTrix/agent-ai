# ── MCP Node server ───────────────────────────────────────────────
NODE_MCP_ENTRY=/home/USER/ai-prueba/mcp_server/dist/main.js
NODE_MCP_CWD=/home/USER/ai-prueba/mcp_server

# ── API Laravel ───────────────────────────────────────────────────
API_BASE_URL=https://tu-laravel.com/api

# ── LLM Thinker (planificador — decide qué tool usar, devuelve JSON) ──
# Modelo local ligero para ahorrar tokens del Answerer.
# Si no se define, usa el mismo que el Answerer.
# LLM_THINKER_BASE_URL=http://localhost:11434/v1
# LLM_THINKER_MODEL=llama3.2:3b

# ── LLM Answerer (analizador — genera respuesta en lenguaje natural) ──
LLM_PROVIDER=openai_compat
LLM_ANSWERER_API_KEY=tu-api-key
LLM_ANSWERER_BASE_URL=https://api.groq.com/openai/v1
LLM_ANSWERER_MODEL=llama-3.3-70b-versatile

# ── Timeouts ──────────────────────────────────────────────────────
MCP_INIT_TIMEOUT=60
MCP_TOOL_TIMEOUT=30
LLM_TIMEOUT=30
OVERALL_TIMEOUT=120
HTTP_TIMEOUT_MS=25000

# ── Debug ─────────────────────────────────────────────────────────
DEBUG_MCP=0
MCP_LOG_FILE=

# ── FastAPI ───────────────────────────────────────────────────────
ALLOW_ORIGINS=http://localhost:3000
MAX_CONCURRENT_REQUESTS=3
MAX_ROWS_TO_LLM=100
