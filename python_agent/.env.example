# ── MCP Node server (subprocess lanzado por el agente vía stdio) ──
# Ruta absoluta al main.js compilado del mcp_server
NODE_MCP_ENTRY=/home/USER/ai-prueba/mcp_server/dist/main.js
NODE_MCP_CWD=/home/USER/ai-prueba/mcp_server

# ── API Laravel (la consume el mcp_server) ────────────────────────
API_BASE_URL=https://tu-laravel.com/api
# API_TOKEN=                # opcional, si la API requiere bearer

# ── LLM (Ollama local en el VPS, OpenAI-compatible) ───────────────
LLM_PROVIDER=openai_compat
LLAMA_API_KEY=dummy-key
LLAMA_BASE_URL=http://localhost:11434/v1
LLAMA_MODEL=qwen2.5:3b

# ── Timeouts ──────────────────────────────────────────────────────
MCP_INIT_TIMEOUT=60
MCP_TOOL_TIMEOUT=30
LLM_TIMEOUT=35
OVERALL_TIMEOUT=120
HTTP_TIMEOUT_MS=25000

# ── Debug ─────────────────────────────────────────────────────────
DEBUG_MCP=0
MCP_LOG_FILE=mcp_debug.log
LOG_TOOL_RESPONSE=0
LOG_TOOL_RESPONSE_MAX_CHARS=4000
LOG_TOOL_RESPONSE_REDACT=1

# ── Excel export ──────────────────────────────────────────────────
EXCEL_EXPORT_THRESHOLD=50
EXCEL_EXPORT_MAX_ROWS=50000

# ── Naturalización / pasos ────────────────────────────────────────
NATURALIZE_WITH_LLM=1
NATURALIZE_SAMPLE_ROWS=10
NATURALIZE_MAX_CHARS=1200
MAX_TOOL_STEPS=5

# ── FastAPI ───────────────────────────────────────────────────────
ALLOW_ORIGINS=http://localhost:3000,https://tu-frontend.com
MAX_CONCURRENT_REQUESTS=3
